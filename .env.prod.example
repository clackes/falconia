# Production.   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# The two hostnames must be DIFFERENT and both point at the nginx container.

POSTGRES_USER=falconia
POSTGRES_PASSWORD=<a long password>
POSTGRES_DB=falconia

APP_BASE_URL=https://falconia.example.com
CONTENT_BASE_URL=https://usercontent.falconia.example.com
API_BASE_URL=https://falconia.example.com

# openssl rand -hex 32   (a different one for each)
JWT_SECRET=<32 hex bytes>
CONTENT_SECRET=<32 hex bytes>

# Changing JWT_SECRET signs everyone out.
# Changing CONTENT_SECRET only invalidates artifact content URLs already open.

# Invite-only after the first account (the first account always gets in and
# becomes admin).
ALLOW_REGISTRATION=false

BLOB_BACKEND=fs
MAX_UPLOAD_MB=64

# The Docker network your reverse proxy or tunnel lives on.
PROXY_NETWORK=proxy

# Upgrading an existing install? Point these at the volumes you already have
# (see `docker volume ls`) so the data comes along.
# POSTGRES_VOLUME=falconia_postgres_data
# BLOB_VOLUME=falconia_blob_data

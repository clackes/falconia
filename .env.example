# Copy to .env and adjust.   cp .env.example .env

# --- Host ports ---
# Change them if something on this machine already uses them. They must stay
# consistent with the addresses below.
APP_PORT=5173
API_PORT=8080
CONTENT_PORT=8081
POSTGRES_PORT=5432

# --- Database ---
POSTGRES_USER=falconia
POSTGRES_PASSWORD=falconia_dev_password
POSTGRES_DB=falconia

# --- Addresses ---
# APP_BASE_URL and CONTENT_BASE_URL MUST be different origins: untrusted
# artifacts cannot share the application's origin. Startup fails if they match.
APP_BASE_URL=http://localhost:5173
CONTENT_BASE_URL=http://localhost:8081
API_BASE_URL=http://localhost:8080
VITE_API_BASE=http://localhost:8080

# --- Secrets ---
# Fine as they are for development. With ENV=production they are required and
# must be at least 16 characters long.
#   openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-me-16
CONTENT_SECRET=dev-content-secret-change-me

# --- Sign-up ---
# With false, only invited people can join. Sign-up stays open anyway while the
# instance has no users at all, otherwise there would be no way to create the
# first administrator.
ALLOW_REGISTRATION=true

# --- File storage ---
# fs = a Docker volume, no extra service.  s3 = any S3-compatible bucket.
BLOB_BACKEND=fs
# S3_ENDPOINT=minio:9000
# S3_ACCESS_KEY=falconia
# S3_SECRET_KEY=falconia_dev_password
# S3_BUCKET=falconia
# S3_USE_SSL=false

MAX_UPLOAD_MB=64
MAX_BUNDLE_FILES=500

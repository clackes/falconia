{
  "name": "falconia-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "monaco": "rm -rf public/monaco && mkdir -p public/monaco && cp -r node_modules/monaco-editor/min/vs public/monaco/vs",
    "predev": "npm run monaco",
    "dev": "vite",
    "prebuild": "npm run monaco",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
